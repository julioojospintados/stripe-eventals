# Configurazione di esempio di EAS8. Copiala in .env (mai nel repository) e riempi i valori.
# I segreti stanno solo nel .env, fuori dalla document root.

APP_NAME="EAS8"
# local in sviluppo, production sull'hosting.
APP_ENV=local
# Generata con: php artisan key:generate (cifra sessioni, cookie e colonne cifrate: non cambiarla dopo il lancio).
APP_KEY=
# false in produzione.
APP_DEBUG=true
# Indirizzo pubblico del sito, senza barra finale (link nelle email, ritorno da Stripe).
APP_URL=http://localhost:8000

# Inglese predefinito, italiano seconda lingua.
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# Password dello staff con argon2id (PHP compilato con argon2: php -r "var_dump(defined('PASSWORD_ARGON2ID'));").
HASH_DRIVER=argon2id
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Database: MySQL 8.0.16+ (DB_CONNECTION=mysql) o MariaDB 10.7+ (DB_CONNECTION=mariadb). Niente SQLite.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eas8
DB_USERNAME=eas8
DB_PASSWORD=
# true solo se l'hosting non permette i trigger (errore 1419, log binario senza log_bin_trust_function_creators):
# le migrazioni li saltano con un avviso nel log. Vedi docs/architettura.md §3.
DB_TRIGGERS_OPTIONAL=false

# Sessioni nel database, cookie solo su HTTPS in produzione.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# true in produzione (HTTPS).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Coda nel database, lavorata dal cron ogni minuto (docs/architettura.md §8).
QUEUE_CONNECTION=database

CACHE_STORE=database

# Stripe: SOLO chiavi di test (sk_test_...) finché il cliente non dice altro.
STRIPE_SECRET_KEY=
# Segreto del webhook (whsec_...), dalla dashboard di Stripe o da "stripe listen".
STRIPE_WEBHOOK_SECRET=
# Versione dell'API fissata, la stessa del webhook nella dashboard (es. 2026-10-28.endive, quella di stripe-php 22).
STRIPE_API_VERSION=
# Price ricorrente annuale della membership (price_...), creato nella Dashboard Stripe (200 €/anno).
STRIPE_MEMBERSHIP_PRICE=

# Email: casella SMTP esistente del cliente (circa 1.000 email l'ora). In sviluppo MAIL_MAILER=log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="website@orthocongress.org"
MAIL_FROM_NAME="${APP_NAME}"
# Email in coda al minuto (biglietti, avvisi): sotto il limite della casella con margine per i codici di accesso.
MAIL_RATE_PER_MINUTE=15

# Firma Ed25519 dei QR dei biglietti (ext-sodium). Chiave privata in base64, generata con:
# php -r 'echo base64_encode(sodium_crypto_sign_secretkey(sodium_crypto_sign_keypair())), PHP_EOL;'
QR_SIGNING_PRIVATE_KEY=
# Identificativo della chiave scritto nel QR: cambialo quando ruoti la chiave.
QR_SIGNING_KEY_ID=k1
# Dopo una rotazione: chiavi pubbliche precedenti, solo per verificare, nel formato k1:base64,k2:base64.
QR_PREVIOUS_PUBLIC_KEYS=

VITE_APP_NAME="${APP_NAME}"
