# Ambiente di prova (staging) di EAS8. Parti da .env.example (cp .env.example .env) e sostituisci questi valori:
# il resto (QR, fatture, membership…) resta come lì. Database, utente, dominio, APP_KEY e chiave dei QR propri,
# mai quelli della produzione. Autore: Giulio Occhipinti.

APP_NAME="EAS8 staging"
# staging: striscia «STAGING» su pagine e pannello, pagine con noindex.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://staging.example.org

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=eas8_staging
DB_USERNAME=eas8_staging
DB_PASSWORD=
DB_TRIGGERS_OPTIONAL=false

SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true

QUEUE_CONNECTION=database
QUEUE_WORKER_MODE=daemon
CACHE_STORE=database

# Stripe SOLO in modalità test (sk_test_..., price_... di test). Webhook: un endpoint di test nella Dashboard verso
# https://staging.example.org/stripe/webhook, oppure "stripe listen" (sito/README.md, «Staging»).
STRIPE_SECRET_KEY=sk_test_
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_MEMBERSHIP_PRICE=

# Email intercettate: nessuna parte verso i clienti veri.
# log: nel file storage/logs/laravel-*.log. Con Mailpit sul server: MAIL_MAILER=smtp, MAIL_HOST=127.0.0.1, MAIL_PORT=1025.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="staging@example.org"
MAIL_FROM_NAME="${APP_NAME}"

# Chiave dei QR propria dello staging (comando in .env.example): un QR di prova non vale all'evento.
QR_SIGNING_PRIVATE_KEY=
QR_SIGNING_KEY_ID=staging1

# Organizzatore dell'installazione (config/eventals.php, sito/README.md). Fuso e valuta di ogni evento nel pannello.
EVENTALS_ORGANIZER_NAME="European Aligner Society"
EVENTALS_CONTACT_EMAIL=office@eas-aligners.com
EVENTALS_LOGO=images/eas-logo.png
EVENTALS_TIMEZONE=Europe/Lisbon
EVENTALS_CURRENCY=eur
QR_PREFIX=EAS1
