# Avvia eas8-scheduler.service all'inizio di ogni minuto. Autore: Giulio Occhipinti.
# Installazione: sudo cp eas8-scheduler.service eas8-scheduler.timer /etc/systemd/system/
#                sudo systemctl daemon-reload && sudo systemctl enable --now eas8-scheduler.timer
[Unit]
Description=EAS8 scheduler every minute

[Timer]
OnCalendar=*-*-* *:*:00
AccuracySec=1s

[Install]
WantedBy=timers.target
